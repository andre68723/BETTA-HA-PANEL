{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "panel4",
            "displayName": "Panel 4\" 720x720 (smart86 base)",
            "description": "Build for the original 4-inch 720x720 round panel.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/panel4",
            "cacheVariables": {
                "SDKCONFIG_DEFAULTS": "config/sdkconfig.defaults;config/sdkconfig.defaults.panel4",
                "SDKCONFIG": "${sourceDir}/build/panel4/sdkconfig"
            }
        },
        {
            "name": "panel10",
            "displayName": "Panel 10.1\" 1280x800 (betta large)",
            "description": "Build for the 10.1-inch 1280x800 MIPI-DSI panel.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/panel10",
            "cacheVariables": {
                "SDKCONFIG_DEFAULTS": "config/sdkconfig.defaults;config/sdkconfig.defaults.panel10",
                "SDKCONFIG": "${sourceDir}/build/panel10/sdkconfig"
            }
        },
        {
            "name": "paneljc",
            "displayName": "Panel JC 10.1\" 800x1280 (Guition JC8012P4A1)",
            "description": "Build for the Guition JC8012P4A1 (ESP32-P4 + JD9365 MIPI-DSI, GSL3680 touch, ESP-Hosted C6 Wi-Fi). Targets the original 'V1' panel revision (rear case date code up to ~2627) \u2014 see docs/choose-display.md.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/paneljc",
            "cacheVariables": {
                "IDF_TARGET": "esp32p4",
                "SDKCONFIG_DEFAULTS": "config/sdkconfig.defaults;config/sdkconfig.defaults.paneljc",
                "SDKCONFIG": "${sourceDir}/build/paneljc/sdkconfig"
            }
        },
        {
            "name": "paneljc-v2",
            "displayName": "Panel JC 10.1\" 800x1280 (Guition JC8012P4A1, V2 panel)",
            "description": "Build for the Guition JC8012P4A1 'V2' panel revision (rear case date code ~2628+) \u2014 different JD9365 init table/timing, same GSL3680 touch. See docs/choose-display.md.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/paneljc-v2",
            "cacheVariables": {
                "IDF_TARGET": "esp32p4",
                "SDKCONFIG_DEFAULTS": "config/sdkconfig.defaults;config/sdkconfig.defaults.paneljc;config/sdkconfig.defaults.paneljc.v2",
                "SDKCONFIG": "${sourceDir}/build/paneljc-v2/sdkconfig"
            }
        },
        {
            "name": "tab5",
            "displayName": "M5Stack Tab5 5\" 1280x720 (planned, not yet run on hardware)",
            "description": "Build for the M5Stack Tab5 (ESP32-P4 + C6, BSP display/touch). Not yet run on hardware; see docs/choose-display.md.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/tab5",
            "cacheVariables": {
                "IDF_TARGET": "esp32p4",
                "SDKCONFIG_DEFAULTS": "config/sdkconfig.defaults;config/sdkconfig.defaults.tab5",
                "SDKCONFIG": "${sourceDir}/build/tab5/sdkconfig"
            }
        }
    ]
}
