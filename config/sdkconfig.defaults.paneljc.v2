# Panel revision overlay: Guition JC8012P4A1 "V2" panel (rear case date
# code ~2628+). Apply together with sdkconfig.defaults and
# sdkconfig.defaults.paneljc via
#   idf.py -D SDKCONFIG_DEFAULTS="config/sdkconfig.defaults;config/sdkconfig.defaults.paneljc;sdkconfig.defaults.paneljc.v2" ...
# or the CMake preset "paneljc-v2" (see CMakePresets.json).
#
# See docs/hardware.md ("JC8012P4A1 panel revisions") for how to identify which
# panel revision you have.

CONFIG_APP_PANELJC_PANEL_V2=y
